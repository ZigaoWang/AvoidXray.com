// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String          @id @default(cuid())
  email                   String          @unique
  passwordHash            String
  username                String          @unique
  name                    String?
  avatar                  String?
  bio                     String?
  website                 String?
  instagram               String?
  twitter                 String?
  isAdmin                 Boolean         @default(false)
  emailVerified           Boolean         @default(false)
  verificationToken       String?
  verificationTokenExpiry DateTime?
  resetToken              String?
  resetTokenExpiry        DateTime?

  /// When this account agreed to the terms, and to which wording.
  ///
  /// The version is the document's own "Last updated" line rather than a
  /// number kept somewhere else, so it cannot be bumped without the text
  /// changing. Both are null for accounts created before consent was
  /// recorded; that is a fact worth being able to see rather than papering
  /// over with a default.
  termsAcceptedAt         DateTime?
  termsVersion            String?

  createdAt               DateTime        @default(now())
  photos                  Photo[]
  cameras                 Camera[]
  likes                   Like[]
  comments                Comment[]
  followers               Follow[]        @relation("following")
  following               Follow[]        @relation("followers")
  notifications           Notification[]
  collections             Collection[]
  communityNotes          CommunityNote[]
  noteVotes               NoteVote[]
  reportsFiled            Report[]        @relation("reportsFiled")
  blocksMade              Block[]         @relation("blocksMade")
  blocksReceived          Block[]         @relation("blocksReceived")
  feedback                Feedback[]      @relation("feedbackAuthor")
  verifiedFields          FieldProvenance[]
}

model Photo {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalPath  String
  thumbnailPath String
  mediumPath    String
  blurHash      String?
  width         Int
  height        Int
  /// Byte size of the stored original. Recorded at upload so the photo page
  /// does not need a blocking HeadObject against object storage on every render.
  originalBytes Int?
  caption       String?
  cameraId      String?
  camera        Camera?           @relation(fields: [cameraId], references: [id])
  filmStockId   String?
  filmStock     FilmStock?        @relation(fields: [filmStockId], references: [id])
  /// Whether the upload finished and the photo is a real, finished row.
  /// NOT a privacy control: unpublished photos are drafts, and a cron deletes
  /// them an hour after upload. Use `visibility` to decide who can see one.
  published     Boolean           @default(false)
  /// Who can see this photo. PRIVATE keeps it out of explore, profiles, film
  /// and camera pages, search and the sitemap; the owner still sees it, and it
  /// still appears inside their own albums.
  visibility    PhotoVisibility   @default(PUBLIC)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @default(now()) @updatedAt
  takenDate     DateTime?
  likes         Like[]
  comments      Comment[]
  collections   CollectionPhoto[]

  @@index([userId])
  @@index([published])
  @@index([createdAt])
  @@index([cameraId])
  @@index([filmStockId])
  @@index([published, createdAt])
  @@index([visibility])
  @@index([published, visibility, createdAt])
  /// These two exist in the database but were missing from this file, so
  /// `prisma migrate diff` proposed dropping them as part of any unrelated
  /// change. They serve the film and camera hub grids, which filter on
  /// published plus one of these columns.
  @@index([published, cameraId])
  @@index([published, filmStockId])
}

/// Deliberately an enum rather than a boolean: an UNLISTED state (reachable by
/// direct link but not listed anywhere) is the obvious next one, and adding it
/// should not mean rewriting every filter.
enum PhotoVisibility {
  PUBLIC  @map("public")
  PRIVATE @map("private")
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoId   String
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, photoId])
  @@index([photoId])
  @@index([userId])
}

model Camera {
  id                 String     @id @default(cuid())
  slug               String?    @unique
  name               String
  /// Superseded by `brandId`. Populated on exactly one of the seventeen rows
  /// this replaced, with the brand folded into `name` on the other sixteen.
  brand              String?
  /// Nullable, unlike a film's. Not every camera has an identifiable brand:
  /// null means "not yet identified" and lands in the research backlog rather
  /// than forcing an invention or a deletion.
  brandId            String?
  /// Names this camera is also sold under. Bodies are routinely renamed by
  /// region, so a record stored under one name is unfindable to everyone who
  /// owns the other. Searched the same way a film stock's aliases are.
  aliases            String[]   @default([])
  brandRef           Brand?     @relation(fields: [brandId], references: [id])
  userId             String
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos             Photo[]
  imageUrl           String?
  description        String?
  imageStatus        String     @default("none") // none, pending, approved, rejected
  imageUploadedBy    String?
  imageUploadedAt    DateTime?
  // Categorization
  /// Superseded by `bodyType`. Retained until its readers have moved across;
  /// do not write to it in new code.
  cameraType         String? // SLR, Rangefinder, Point & Shoot, TLR, Medium Format, Large Format, Instant, Disposable
  /// The mechanism. Null means nobody has classified it yet.
  bodyType           CameraBodyType?
  /// Native frame geometry. Null throughout at introduction: no camera here has
  /// been checked, and full-frame is an assumption rather than a reading.
  frameFormat        FrameFormat?
  format             String? // 35mm, Medium Format (120/220), Large Format (4x5, 8x10), APS, 110, Half-frame
  mountType          String? // Canon FD, Nikon F, Pentax K, M42, Leica M, etc.
  year               Int? // Year of manufacture/release
  defaultFilmStockId String?
  defaultFilmStock   FilmStock? @relation("defaultFilm", fields: [defaultFilmStockId], references: [id])
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @default(now()) @updatedAt

  @@unique([name, userId])
  @@index([brandId])
}

/// Development process. Required: it is the primary way people narrow a
/// film stock, so a row without one cannot be filtered.
enum FilmProcess {
  C41   @map("C-41")
  E6    @map("E-6")
  ECN2  @map("ECN-2")
  BW    @map("B&W")
  OTHER @map("Other")
}

/// How confidently the maker of a film is known.
///
/// Three values were not enough. A great many stocks have a manufacturer that
/// credible sources report but nobody has ever confirmed, because OEM and
/// contract-coating deals in this industry are routinely undisclosed. Filing
/// those as UNKNOWN throws away real information; filing them as KNOWN
/// overstates it. ATTRIBUTED is the honest middle, and "reported as Kodak" is
/// the answer people actually arrive looking for.
enum ManufacturerStatus {
  /// The brand coats its own film. Kodak, Ferrania, Lucky.
  SAME_AS_BRAND
  /// Confirmed to be made by someone else. Kentmere is coated by Harman.
  KNOWN
  /// Widely reported, never officially confirmed. Render as "reported as X",
  /// never as a bare manufacturer name.
  ATTRIBUTED
  /// Nobody has established it. A research item, not a claim.
  UNKNOWN
}

/// How a camera body works, mechanically. Nothing else.
///
/// Deliberately narrow. "Medium Format" and "Large Format" were members of the
/// list this replaces and are gone: they describe the film, not the mechanism.
/// So is "panoramic" — the Hasselblad XPan is a rangefinder that happens to
/// expose a wide frame, and this catalogue's own Trip Panorama 2 is a compact
/// with a mask. Frame geometry lives in FrameFormat.
///
/// Nullable on the model, and with no OTHER member. Null means "not yet
/// classified", which is a different and more honest claim than "we looked and
/// it is none of these" — and unlike a junk-drawer OTHER it shows up as a gap
/// rather than as an answer. Forcing a choice from an incomplete list is how
/// the Lomography Sprocket Rocket came to be filed as a point-and-shoot.
enum CameraBodyType {
  SLR
  RANGEFINDER
  COMPACT
  TLR
  FOLDING
  VIEW
  INSTANT
  DISPOSABLE
}

/// The area of film one exposure covers, natively.
///
/// Native is the operative word. A camera with a panorama switch is not a
/// panoramic camera; it is a full-frame camera that can mask down, and both the
/// Olympus Trip Panorama 2 and the Pentax Espio 120Mi are in that position.
/// Recording the switchable modes as well is a separate field and a later
/// question — this one says what the camera is, not what it can be set to.
enum FrameFormat {
  FULL_FRAME
  HALF_FRAME
  PANORAMIC
  /// Exposes across the perforations, as the Sprocket Rocket does.
  SPROCKET_HOLE
}

/// Whether the film records colour, or tone alone.
///
/// Independent of `process`, which is the reason this exists. Ilford XP2 Super
/// is a black and white film developed in C-41; deriving "colour negative" from
/// its process — as `filmType` did — is simply wrong, and then asks it for a
/// colour balance it cannot have.
enum Chromaticity {
  COLOR
  MONOCHROME
}

/// Whether the developed film is a negative or something you can look at.
///
/// Also independent of chromaticity: Fomapan R100 and Agfa Scala are monochrome
/// *and* positive, a combination the old single `filmType` enum could not
/// express at all.
enum Polarity {
  NEGATIVE
  POSITIVE
  /// Instant materials, which reach a positive by diffusion transfer rather
  /// than through a reversal step.
  DIRECT_POSITIVE
}

/// Light the stock is balanced for. Null means unknown rather than N/A —
/// N/A is the deliberate answer for black and white.
enum ColorBalance {
  DAYLIGHT @map("Daylight")
  TUNGSTEN @map("Tungsten")
  NA       @map("N/A")
}

model FilmStock {
  id                String        @id @default(cuid())
  slug              String?       @unique
  name              String        @unique
  /// Superseded by `manufacturer`, which is required and normalized. Retained
  /// only so existing rows and the Camera relation are undisturbed.
  brand             String?
  /// Superseded by `brandId` + `manufacturedByBrandId`, which separate who a
  /// film is sold as from who coats it. Retained until its readers have moved
  /// across; do not write to it in new code.
  manufacturer      String?

  /// The name on the box. Required: every stock is sold as something.
  brandId           String
  brandRef          Brand   @relation("filmBrand", fields: [brandId], references: [id])

  /// How confidently the coater is known, and who it is.
  ///
  /// Required and undefaulted. A default of SAME_AS_BRAND would quietly assert
  /// "the brand makes it" on every new row, which is the assumption this pair
  /// of columns exists to stop making.
  manufacturerStatus    ManufacturerStatus
  /// Set only for KNOWN and ATTRIBUTED, and enforced by a CHECK. Null for
  /// SAME_AS_BRAND (look at brandId) and for UNKNOWN (nobody has established
  /// it) — two states a nullable column alone could not tell apart.
  manufacturedByBrandId String?
  /// Restrict, not the SET NULL that Prisma defaults a nullable relation to.
  /// Nulling the maker while the status still said KNOWN or ATTRIBUTED would
  /// violate the status CHECK, so the delete fails either way — this way it
  /// fails as a foreign key error naming the brand, rather than as a check
  /// violation on a film nobody was touching.
  manufacturedBy        Brand? @relation("filmManufacturer", fields: [manufacturedByBrandId], references: [id], onDelete: Restrict)
  /// Alternate names and product codes, searchable alongside the name.
  /// e.g. Kodak Vision3 500T carries ["5219", "7219", "VISION3 500T"].
  aliases           String[]      @default([])
  iso               Int?
  photos            Photo[]
  defaultForCameras Camera[]      @relation("defaultFilm")
  imageUrl          String?
  description       String?
  imageStatus       String        @default("none") // none, pending, approved, rejected
  imageUploadedBy   String?
  imageUploadedAt   DateTime?
  // Categorization
  /// Superseded by `chromaticity` + `polarity`, which say the same thing
  /// without collapsing two independent axes into one. Retained until the
  /// readers have moved across; do not write to it in new code.
  filmType          String? // Color Negative (C-41), Slide/Transparency (E-6), Black & White, Instant, Specialty
  /// Colour or monochrome. Required and undefaulted: it is a claim about the
  /// film, and a default would let a future row inherit one nobody made.
  chromaticity      Chromaticity
  /// Negative or positive. Required and undefaulted, for the same reason.
  polarity          Polarity
  /// Multi-valued: a stock is often sold in more than one gauge. The form is
  /// still single-select; this is a data shape change only.
  format            String[]      @default([])
  /// Required. Landed nullable so 003 could ship before the backfill, then
  /// enforced NOT NULL by scripts/sql/004 once every row was resolved.
  process           FilmProcess
  /// Genuinely optional: N/A for black and white, and left unset where the
  /// balance is disputed rather than guessed.
  colorBalance      ColorBalance?

  /// The stock this one is respooled or rebadged from.
  ///
  /// Cinestill 800T is Kodak Vision3 500T with the remjet removed, and Vision3
  /// 500T is a row in this same table — the most useful relationship in the
  /// catalogue, previously unrepresentable. A respool keeps its own page,
  /// samples and notes; this points at where the emulsion came from, so the
  /// source stock can list every rebrand of itself instead of the information
  /// being scattered across unrelated entries.
  ///
  /// Distinct from `manufacturedByBrandId`, which names a company. This names a
  /// product. Cinestill 800T has both: coated by Kodak, respooled from Vision3.
  parentStockId     String?
  parentStock       FilmStock?    @relation("respool", fields: [parentStockId], references: [id], onDelete: Restrict)
  respools          FilmStock[]   @relation("respool")
  variants          FilmVariant[]
  /// What was done to it — remjet removal, different perforation, recut.
  respoolNotes      String?
  exposures         String? // 24, 36, 12, 16, or "24, 36" for multiple
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now()) @updatedAt

  /// Present in the database and previously undeclared here. Both back the
  /// filters on /films.
  @@index([process])
  @@index([colorBalance])
  @@index([brandId])
  @@index([manufacturedByBrandId])
  @@index([parentStockId])
}

/// A name products are sold under.
///
/// Not a manufacturer. The two are different parties often enough that
/// collapsing them — which a single `manufacturer` text column did — makes the
/// catalogue lie about every house brand, respool and rebadge, which is a large
/// and growing share of the film market and precisely the part people are
/// curious about. Kentmere is a brand; Harman coats it.
///
/// One table for film and cameras both. Six of the sixteen initial rows are
/// referenced from both sides, and there is deliberately no `type` column:
/// whether a brand makes film, cameras or both is answered by what points at
/// it, not by a field that would immediately be wrong for Fujifilm.
model Brand {
  /// Rows seeded by the phase 2 migration carry readable ids (`brand_kodak`)
  /// so that migration can be checked by eye. Anything created afterwards gets
  /// an ordinary cuid; nothing depends on the format.
  id      String   @id @default(cuid())
  slug    String   @unique
  name    String   @unique
  /// Other spellings and corporate names, so a search finds the brand under
  /// whichever one the reader knows. "Yestar" for Yes!Star.
  aliases String[] @default([])

  description String?

  /// Corporate ownership, and nothing else.
  ///
  /// Never infer a manufacturer from this. Doing so is right for Kentmere,
  /// whose parent Harman does coat it, and wrong for the next case — which is
  /// how a wrong answer arrives looking correct. The manufacturer of a stock is
  /// `FilmStock.manufacturedByBrandId` and is set per stock or not at all.
  ///
  /// Notably absent: Ilford does not point at Harman. Harman trades as Ilford
  /// Photo under licence from Ilford Imaging Europe, which owns the mark — so
  /// the relationship is a trademark licence running the opposite way from
  /// ownership, and recording it here would be wrong twice over.
  parentBrandId String?
  parentBrand   Brand?  @relation("brandOwnership", fields: [parentBrandId], references: [id])
  children      Brand[] @relation("brandOwnership")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  filmStocks        FilmStock[] @relation("filmBrand")
  manufacturedFilms FilmStock[] @relation("filmManufacturer")
  cameras           Camera[]

  @@index([parentBrandId])
}

/// The gauge a film is sold in.
enum FilmFormat {
  MM35     @map("35mm")
  MM120    @map("120")
  MM220    @map("220")
  MM110    @map("110")
  MM126    @map("126")
  MM127    @map("127")
  INSTANT  @map("instant")
  SHEET_4X5  @map("4x5")
  SHEET_5X7  @map("5x7")
  SHEET_8X10 @map("8x10")
  BULK_35MM  @map("bulk-35mm")
}

/// One buyable version of a film stock.
///
/// A product line is not a product. HP5 Plus is one emulsion sold in 35mm at two
/// exposure counts, in 120, in sheets and in bulk. Holding format and exposure
/// count on the stock itself forces every multi-format film to pick one and
/// pretend the others do not exist.
///
/// Nothing here is worth doing for its own sake yet, since the catalogue is
/// single-format throughout. It is worth doing now because it is mechanical
/// now and contested later.
model FilmVariant {
  id          String    @id @default(cuid())
  filmStockId String
  filmStock   FilmStock @relation(fields: [filmStockId], references: [id], onDelete: Cascade)

  format FilmFormat

  /// Frames on a roll. Null for sheet film and bulk.
  exposures    Int?
  /// Sheets in a box. Null for roll film.
  sheetCount   Int?
  /// Metres on a bulk roll. Null for everything else.
  bulkLengthM  Decimal? @db.Decimal(5, 1)

  /// The manufacturer's own code for this version, where it has one.
  productCode      String?
  discontinuedYear Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  /// One row per real SKU is enforced by a unique index over COALESCE, which
  /// Prisma cannot express and so is not declared here. See docs/db-objects.md.
  @@index([filmStockId])
  @@index([format])
}

/// Where a stored value came from.
///
/// The catalogue is only worth trusting if a reader can tell a manufacturer
/// datasheet from somebody's recollection. This is that distinction, and it is
/// what lets a bad batch of generated values be found and re-run later instead
/// of quietly becoming part of the record.
enum ValueSource {
  /// Predates provenance tracking. Origin genuinely unknown: some of it was
  /// entered by contributors, some by an administrator, and some drafted with
  /// model assistance. Recording it as `USER` would assert something nobody
  /// checked, so this says only what is true.
  IMPORT
  /// Submitted by a contributor through a form.
  USER
  /// Entered or corrected by an administrator.
  ADMIN
  /// A cited secondary source: a review, a retailer listing, an encyclopedia.
  RESEARCH
  /// The manufacturer's own document or product page. The strongest kind.
  DATASHEET
  /// Proposed by a model. Never trusted without a citation and a human.
  LLM
}

/// Which table a polymorphic row points at.
enum EntityType {
  FILM_STOCK
  FILM_VARIANT
  CAMERA
  BRAND
}

/// One row per field per record, saying where that field's value came from.
///
/// Cheap, and it is the table that makes the rest trustworthy. It answers
/// "which of these numbers has anybody actually checked", which is the question
/// separating this catalogue from a list somebody typed.
///
/// Polymorphic, so there is no foreign key to enforce the target exists.
/// Postgres cannot express one across four tables. Cleanup is handled by an
/// AFTER DELETE trigger on each entity table instead. See docs/db-objects.md.
model FieldProvenance {
  entityType EntityType
  entityId   String
  /// The Prisma field name, so a reader can match it to the schema.
  fieldName  String

  source    ValueSource
  sourceUrl String?

  /// A model's own reported confidence. Advisory, never a gate.
  confidence Decimal? @db.Decimal(3, 2)
  /// Which model wrote it, when the source is a model.
  model      String?
  /// Lets every field written by one bad prompt be found and requeued.
  promptHash String?

  /// Set when a person has confirmed the value against the source. Null is the
  /// backlog: everything unverified is work waiting to be done.
  verifiedById String?
  verifiedBy   User?     @relation(fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@id([entityType, entityId, fieldName])
  @@index([entityType, entityId])
  @@index([source])
}

/// Slugs a film stock or camera used to carry.
///
/// A slug is built from the name, so renaming a record changes its URL. Without
/// a record of what the URL used to be, every existing link to it — indexed
/// pages, other people's posts — would 404, because the resolver looks a slug
/// up by exact match and the old one no longer exists on any row.
///
/// Retired slugs are kept here instead, and the resolver falls back to this
/// table before giving up, then redirects to the record's current URL.
///
/// `kind` is part of the key because /films and /cameras are separate
/// namespaces: the same slug may legitimately be retired in both.
model SlugHistory {
  /// "film" or "camera".
  kind      String
  slug      String
  /// The FilmStock or Camera this slug used to point at. Not a relation, since
  /// it refers to one of two tables depending on `kind`.
  targetId  String
  createdAt DateTime @default(now())

  @@id([kind, slug])
  @@index([kind, targetId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("followers", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoId   String
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([photoId])
  @@index([userId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  actorId   String
  photoId   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
}

model Collection {
  id          String            @id @default(cuid())
  name        String
  description String?
  coverImage  String?
  featured    Boolean           @default(false)
  public      Boolean           @default(false)
  userId      String?
  user        User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  photos      CollectionPhoto[]

  @@index([userId])
  @@index([featured])
  @@index([public])
}

model CollectionPhoto {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  photoId      String
  photo        Photo      @relation(fields: [photoId], references: [id], onDelete: Cascade)
  order        Int        @default(0)

  @@unique([collectionId, photoId])
  @@index([collectionId])
  @@index([photoId])
}

// Community notes on cameras + film stocks
model CommunityNote {
  id         String     @id @default(cuid())
  targetType String // 'camera' or 'filmstock'
  targetId   String
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  content    String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  votes      NoteVote[]

  @@index([targetType, targetId])
  @@index([userId])
  @@index([createdAt])
}

model NoteVote {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteId    String
  note      CommunityNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([userId, noteId])
  @@index([noteId])
}

// Moderation queue for camera/filmstock edits
model ModerationSubmission {
  id           String @id @default(cuid())
  resourceType String // 'camera' or 'filmstock'
  resourceId   String // ID of camera or filmstock
  submittedBy  String // User ID who submitted
  status       String @default("pending") // pending, approved, rejected

  // Proposed changes (JSON diff)
  proposedImage String? // New image URL (temporary OSS location)
  proposedData  Json // { description, cameraType, format, etc }

  // Original state (for comparison)
  originalImage String? // Current image URL before edit
  originalData  Json // Current data before edit

  // Admin review
  reviewedBy  String? // Admin user ID
  reviewedAt  DateTime?
  reviewNotes String? // Admin can add notes

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resourceType, resourceId])
  @@index([status])
  @@index([submittedBy])
  @@index([createdAt])
}

/// What a report is about. Kept as an enum rather than a free string so a
/// queue cannot fill with typo'd variants of the same category.
enum ReportReason {
  SPAM
  NOT_FILM
  INAPPROPRIATE
  HARASSMENT
  COPYRIGHT
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

/// Something a reader has flagged for a human to look at.
///
/// Polymorphic by (targetType, targetId) rather than one nullable foreign key
/// per kind: photos, comments, users and community notes are all reportable and
/// the list will grow. The trade-off is that a deleted target leaves the report
/// pointing at nothing, so the queue resolves each target when it renders and
/// says so when it has gone.
model Report {
  id         String       @id @default(cuid())
  targetType String // 'photo' | 'comment' | 'user' | 'note'
  targetId   String
  reason     ReportReason
  /// Optional context from the reporter.
  detail     String?
  status     ReportStatus @default(OPEN)

  reporterId String
  reporter   User   @relation("reportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)

  /// Admin follow-up.
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One report per person per thing: re-reporting is not a vote, and letting
  /// it through would let one account flood the queue on its own.
  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([targetType, targetId])
}

/// A person whose content someone does not want to see.
///
/// Deliberately one-directional and mutual in effect: the blocker stops seeing
/// the blocked account, and the blocked account stops seeing the blocker, so
/// blocking cannot be used to watch someone who has shut you out.
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("blocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("blocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

/// Something a visitor wants to tell us about the site itself: a bug, an idea,
/// a question.
///
/// Deliberately not the `Report` model. That one is content moderation — it is
/// keyed to a photo or a comment, requires an account, and allows one report
/// per person per target. This is a message about the software, it has to work
/// for someone who is signed out and cannot even register, and the same person
/// may legitimately send several.
model Feedback {
  id        String       @id @default(cuid())
  /// Short unguessable code the reporter uses to check back, e.g. "AX-7QK4M2XTB9".
  /// Also the capability that grants access to the status page, since there is
  /// no account to authenticate a signed-out reporter against.
  reference String       @unique
  kind      FeedbackKind
  message   String

  /// Optional in both directions: the reporter may be signed out, and may
  /// decline to leave an address. Without one they can still follow the
  /// reference link; they simply are not emailed.
  email  String?
  userId String?
  user   User?   @relation("feedbackAuthor", fields: [userId], references: [id], onDelete: SetNull)

  /// Captured automatically so nobody has to describe their own browser.
  pageUrl   String?
  userAgent String?

  status FeedbackStatus @default(OPEN)

  /// When the sender last asked us to look at this again. Held here rather
  /// than inferred from the thread so the cooldown survives a page reload and
  /// cannot be reset by clearing browser state.
  lastNudgeAt DateTime?

  /// The conversation after the opening message. Replaces a single `reply`
  /// column, which made the status page a dead end: the sender could read an
  /// answer and had no way to respond to it except by opening a second,
  /// unrelated report.
  messages FeedbackMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

/// One message in a feedback thread. The opening message stays on Feedback
/// itself; these are everything said afterwards, by either side.
model FeedbackMessage {
  id         String         @id @default(cuid())
  feedbackId String
  feedback   Feedback       @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  body       String
  author     FeedbackAuthor
  /// The administrator who wrote a staff reply. Null on sender messages, which
  /// are authenticated by the reference alone and have no account behind them.
  authorId   String?
  createdAt  DateTime       @default(now())

  @@index([feedbackId, createdAt])
}

enum FeedbackAuthor {
  SENDER
  STAFF
}

/// Kept short and in plain language: these are the words the reporter picks
/// from, not internal taxonomy.
enum FeedbackKind {
  BUG
  IDEA
  QUESTION
  OTHER
}

enum FeedbackStatus {
  OPEN
  PLANNED
  FIXED
  DECLINED
}
