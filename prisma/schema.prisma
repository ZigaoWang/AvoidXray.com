// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String          @id @default(cuid())
  email                   String          @unique
  passwordHash            String
  username                String          @unique
  name                    String?
  avatar                  String?
  bio                     String?
  website                 String?
  instagram               String?
  twitter                 String?
  isAdmin                 Boolean         @default(false)
  emailVerified           Boolean         @default(false)
  verificationToken       String?
  verificationTokenExpiry DateTime?
  resetToken              String?
  resetTokenExpiry        DateTime?
  createdAt               DateTime        @default(now())
  photos                  Photo[]
  cameras                 Camera[]
  likes                   Like[]
  comments                Comment[]
  followers               Follow[]        @relation("following")
  following               Follow[]        @relation("followers")
  notifications           Notification[]
  collections             Collection[]
  communityNotes          CommunityNote[]
  noteVotes               NoteVote[]
  reportsFiled            Report[]        @relation("reportsFiled")
  blocksMade              Block[]         @relation("blocksMade")
  blocksReceived          Block[]         @relation("blocksReceived")
  feedback                Feedback[]      @relation("feedbackAuthor")
}

model Photo {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalPath  String
  thumbnailPath String
  mediumPath    String
  blurHash      String?
  width         Int
  height        Int
  /// Byte size of the stored original. Recorded at upload so the photo page
  /// does not need a blocking HeadObject against object storage on every render.
  originalBytes Int?
  caption       String?
  cameraId      String?
  camera        Camera?           @relation(fields: [cameraId], references: [id])
  filmStockId   String?
  filmStock     FilmStock?        @relation(fields: [filmStockId], references: [id])
  /// Whether the upload finished and the photo is a real, finished row.
  /// NOT a privacy control: unpublished photos are drafts, and a cron deletes
  /// them an hour after upload. Use `visibility` to decide who can see one.
  published     Boolean           @default(false)
  /// Who can see this photo. PRIVATE keeps it out of explore, profiles, film
  /// and camera pages, search and the sitemap; the owner still sees it, and it
  /// still appears inside their own albums.
  visibility    PhotoVisibility   @default(PUBLIC)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @default(now()) @updatedAt
  takenDate     DateTime?
  likes         Like[]
  comments      Comment[]
  collections   CollectionPhoto[]

  @@index([userId])
  @@index([published])
  @@index([createdAt])
  @@index([cameraId])
  @@index([filmStockId])
  @@index([published, createdAt])
  @@index([visibility])
  @@index([published, visibility, createdAt])
  /// These two exist in the database but were missing from this file, so
  /// `prisma migrate diff` proposed dropping them as part of any unrelated
  /// change. They serve the film and camera hub grids, which filter on
  /// published plus one of these columns.
  @@index([published, cameraId])
  @@index([published, filmStockId])
}

/// Deliberately an enum rather than a boolean: an UNLISTED state (reachable by
/// direct link but not listed anywhere) is the obvious next one, and adding it
/// should not mean rewriting every filter.
enum PhotoVisibility {
  PUBLIC  @map("public")
  PRIVATE @map("private")
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoId   String
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, photoId])
  @@index([photoId])
  @@index([userId])
}

model Camera {
  id                 String     @id @default(cuid())
  slug               String?    @unique
  name               String
  brand              String?
  userId             String
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos             Photo[]
  imageUrl           String?
  description        String?
  imageStatus        String     @default("none") // none, pending, approved, rejected
  imageUploadedBy    String?
  imageUploadedAt    DateTime?
  // Categorization
  cameraType         String? // SLR, Rangefinder, Point & Shoot, TLR, Medium Format, Large Format, Instant, Disposable
  format             String? // 35mm, Medium Format (120/220), Large Format (4x5, 8x10), APS, 110, Half-frame
  mountType          String? // Canon FD, Nikon F, Pentax K, M42, Leica M, etc.
  year               Int? // Year of manufacture/release
  defaultFilmStockId String?
  defaultFilmStock   FilmStock? @relation("defaultFilm", fields: [defaultFilmStockId], references: [id])
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @default(now()) @updatedAt

  @@unique([name, userId])
}

/// Development process. Required: it is the primary way people narrow a
/// film stock, so a row without one cannot be filtered.
enum FilmProcess {
  C41   @map("C-41")
  E6    @map("E-6")
  ECN2  @map("ECN-2")
  BW    @map("B&W")
  OTHER @map("Other")
}

/// Light the stock is balanced for. Null means unknown rather than N/A —
/// N/A is the deliberate answer for black and white.
enum ColorBalance {
  DAYLIGHT @map("Daylight")
  TUNGSTEN @map("Tungsten")
  NA       @map("N/A")
}

model FilmStock {
  id                String        @id @default(cuid())
  slug              String?       @unique
  name              String        @unique
  /// Superseded by `manufacturer`, which is required and normalized. Retained
  /// only so existing rows and the Camera relation are undisturbed.
  brand             String?
  /// Normalized on save, so "KODAK" and "kodak" cannot both exist.
  manufacturer      String?
  /// Alternate names and product codes, searchable alongside the name.
  /// e.g. Kodak Vision3 500T carries ["5219", "7219", "VISION3 500T"].
  aliases           String[]      @default([])
  iso               Int?
  photos            Photo[]
  defaultForCameras Camera[]      @relation("defaultFilm")
  imageUrl          String?
  description       String?
  imageStatus       String        @default("none") // none, pending, approved, rejected
  imageUploadedBy   String?
  imageUploadedAt   DateTime?
  // Categorization
  filmType          String? // Color Negative (C-41), Slide/Transparency (E-6), Black & White, Instant, Specialty
  /// Multi-valued: a stock is often sold in more than one gauge. The form is
  /// still single-select; this is a data shape change only.
  format            String[]      @default([])
  /// Required. Landed nullable so 003 could ship before the backfill, then
  /// enforced NOT NULL by scripts/sql/004 once every row was resolved.
  process           FilmProcess
  /// Genuinely optional: N/A for black and white, and left unset where the
  /// balance is disputed rather than guessed.
  colorBalance      ColorBalance?
  exposures         String? // 24, 36, 12, 16, or "24, 36" for multiple
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now()) @updatedAt

  /// Present in the database and previously undeclared here. Both back the
  /// filters on /films.
  @@index([process])
  @@index([colorBalance])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("followers", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoId   String
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([photoId])
  @@index([userId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  actorId   String
  photoId   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
}

model Collection {
  id          String            @id @default(cuid())
  name        String
  description String?
  coverImage  String?
  featured    Boolean           @default(false)
  public      Boolean           @default(false)
  userId      String?
  user        User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  photos      CollectionPhoto[]

  @@index([userId])
  @@index([featured])
  @@index([public])
}

model CollectionPhoto {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  photoId      String
  photo        Photo      @relation(fields: [photoId], references: [id], onDelete: Cascade)
  order        Int        @default(0)

  @@unique([collectionId, photoId])
  @@index([collectionId])
  @@index([photoId])
}

// Community notes on cameras + film stocks
model CommunityNote {
  id         String     @id @default(cuid())
  targetType String // 'camera' or 'filmstock'
  targetId   String
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  content    String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  votes      NoteVote[]

  @@index([targetType, targetId])
  @@index([userId])
  @@index([createdAt])
}

model NoteVote {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteId    String
  note      CommunityNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([userId, noteId])
  @@index([noteId])
}

// Moderation queue for camera/filmstock edits
model ModerationSubmission {
  id           String @id @default(cuid())
  resourceType String // 'camera' or 'filmstock'
  resourceId   String // ID of camera or filmstock
  submittedBy  String // User ID who submitted
  status       String @default("pending") // pending, approved, rejected

  // Proposed changes (JSON diff)
  proposedImage String? // New image URL (temporary OSS location)
  proposedData  Json // { description, cameraType, format, etc }

  // Original state (for comparison)
  originalImage String? // Current image URL before edit
  originalData  Json // Current data before edit

  // Admin review
  reviewedBy  String? // Admin user ID
  reviewedAt  DateTime?
  reviewNotes String? // Admin can add notes

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resourceType, resourceId])
  @@index([status])
  @@index([submittedBy])
  @@index([createdAt])
}

/// What a report is about. Kept as an enum rather than a free string so a
/// queue cannot fill with typo'd variants of the same category.
enum ReportReason {
  SPAM
  NOT_FILM
  INAPPROPRIATE
  HARASSMENT
  COPYRIGHT
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

/// Something a reader has flagged for a human to look at.
///
/// Polymorphic by (targetType, targetId) rather than one nullable foreign key
/// per kind: photos, comments, users and community notes are all reportable and
/// the list will grow. The trade-off is that a deleted target leaves the report
/// pointing at nothing, so the queue resolves each target when it renders and
/// says so when it has gone.
model Report {
  id         String       @id @default(cuid())
  targetType String // 'photo' | 'comment' | 'user' | 'note'
  targetId   String
  reason     ReportReason
  /// Optional context from the reporter.
  detail     String?
  status     ReportStatus @default(OPEN)

  reporterId String
  reporter   User   @relation("reportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)

  /// Admin follow-up.
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One report per person per thing: re-reporting is not a vote, and letting
  /// it through would let one account flood the queue on its own.
  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([targetType, targetId])
}

/// A person whose content someone does not want to see.
///
/// Deliberately one-directional and mutual in effect: the blocker stops seeing
/// the blocked account, and the blocked account stops seeing the blocker, so
/// blocking cannot be used to watch someone who has shut you out.
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("blocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("blocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

/// Something a visitor wants to tell us about the site itself: a bug, an idea,
/// a question.
///
/// Deliberately not the `Report` model. That one is content moderation — it is
/// keyed to a photo or a comment, requires an account, and allows one report
/// per person per target. This is a message about the software, it has to work
/// for someone who is signed out and cannot even register, and the same person
/// may legitimately send several.
model Feedback {
  id        String       @id @default(cuid())
  /// Short unguessable code the reporter uses to check back, e.g. "AX-7QK4M2XTB9".
  /// Also the capability that grants access to the status page, since there is
  /// no account to authenticate a signed-out reporter against.
  reference String       @unique
  kind      FeedbackKind
  message   String

  /// Optional in both directions: the reporter may be signed out, and may
  /// decline to leave an address. Without one they can still follow the
  /// reference link; they simply are not emailed.
  email  String?
  userId String?
  user   User?   @relation("feedbackAuthor", fields: [userId], references: [id], onDelete: SetNull)

  /// Captured automatically so nobody has to describe their own browser.
  pageUrl   String?
  userAgent String?

  status FeedbackStatus @default(OPEN)

  /// When the sender last asked us to look at this again. Held here rather
  /// than inferred from the thread so the cooldown survives a page reload and
  /// cannot be reset by clearing browser state.
  lastNudgeAt DateTime?

  /// The conversation after the opening message. Replaces a single `reply`
  /// column, which made the status page a dead end: the sender could read an
  /// answer and had no way to respond to it except by opening a second,
  /// unrelated report.
  messages FeedbackMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

/// One message in a feedback thread. The opening message stays on Feedback
/// itself; these are everything said afterwards, by either side.
model FeedbackMessage {
  id         String         @id @default(cuid())
  feedbackId String
  feedback   Feedback       @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  body       String
  author     FeedbackAuthor
  /// The administrator who wrote a staff reply. Null on sender messages, which
  /// are authenticated by the reference alone and have no account behind them.
  authorId   String?
  createdAt  DateTime       @default(now())

  @@index([feedbackId, createdAt])
}

enum FeedbackAuthor {
  SENDER
  STAFF
}

/// Kept short and in plain language: these are the words the reporter picks
/// from, not internal taxonomy.
enum FeedbackKind {
  BUG
  IDEA
  QUESTION
  OTHER
}

enum FeedbackStatus {
  OPEN
  PLANNED
  FIXED
  DECLINED
}
