# PostgreSQL Database
# Local development: postgresql://USER:PASSWORD@localhost:5432/avoidxraydb
# Production: Use your hosting provider's connection string (Railway, Supabase, Neon, etc.)
DATABASE_URL="postgresql://postgres:password@localhost:5432/avoidxraydb"

NEXTAUTH_SECRET="your-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Aliyun OSS
ALIYUN_OSS_REGION="oss-cn-hongkong"
ALIYUN_OSS_BUCKET="avoidxray"
ALIYUN_OSS_ACCESS_KEY_ID="your-access-key-id"
ALIYUN_OSS_ACCESS_KEY_SECRET="your-access-key-secret"

# Mailtrap (for email verification)
MAILTRAP_API_KEY="your-mailtrap-api-key"

# Authenticates the hourly job that removes abandoned upload drafts.
# Required in production; the endpoint refuses unauthenticated calls there.
CRON_SECRET="generate-a-long-random-string"

# Umami analytics. Self-hosted on the same box, bound to loopback, and proxied
# first-party by nginx: the tracker is /s.js on this domain and it reports to
# /_e. Leave unset in development and the script is not rendered at all, so a
# dev server records nothing. Not a secret; it is visible in the page source.
NEXT_PUBLIC_UMAMI_WEBSITE_ID="the-website-id-from-the-umami-dashboard"

# Reading analytics back out of Umami for the admin panel. Loopback, so no TLS
# and no public endpoint. UMAMI_API_KEY is deliberately not NEXT_PUBLIC_: Next
# only inlines prefixed variables into client code, which is what keeps the key
# out of the browser. Mint a key in the Umami dashboard under Profile.
UMAMI_URL="http://127.0.0.1:3001"
UMAMI_API_KEY="umami_..."
UMAMI_WEBSITE_ID="the-website-id-from-the-umami-dashboard"
