# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
/src/generated/prisma
/prisma/dev.db
/prisma/dev.db-journal

# uploads (user content)
/public/uploads/originals/*
/public/uploads/medium/*
/public/uploads/thumbs/*
!public/uploads/originals/.gitkeep
!public/uploads/medium/.gitkeep
!public/uploads/thumbs/.gitkeep
/public/avatars/*
!public/avatars/.gitkeep

# Generated by next dev/build (agentRules). Regenerated on every run, so they
# are build output rather than something to keep in the history.
/AGENTS.md
/CLAUDE.md

# Generated from the live database by scripts/catalog-worklist.ts. A snapshot of
# the catalog does not belong in a public repository, and it is stale the moment
# somebody edits an entry.
/catalog-worklist.md

# Catalog copy staged for a rewrite pass. Content, not code: every value in
# these files is an editable database field, and a description corrected
# through the admin screen would leave the committed copy silently stale. The
# scripts that read them are code and are tracked; what gets loaded is not.
/scripts/rewrite/*.json

# vision worker model downloads
/.vision-models/
